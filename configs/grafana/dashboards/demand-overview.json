{
  "title": "Demand Overview",
  "tags": ["demand-forecasting", "phase-3"],
  "refresh": "30s",
  "time": {"from": "now-30d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Total Demand (30 days)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "refId": "A",
        "rawSql": "SELECT COALESCE(SUM(total_qty), 0) FROM actuals_daily_rollup WHERE bucket >= now() - interval '30 days'",
        "format": "table"
      }],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}
    },
    {
      "id": 2,
      "title": "Total Revenue (30 days)",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "refId": "A",
        "rawSql": "SELECT COALESCE(SUM(total_revenue), 0) FROM actuals_daily_rollup WHERE bucket >= now() - interval '30 days'",
        "format": "table"
      }],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 0}}
    },
    {
      "id": 3,
      "title": "Active Products",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "refId": "A",
        "rawSql": "SELECT COUNT(DISTINCT product_id) FROM actuals_daily_rollup WHERE bucket >= now() - interval '30 days'",
        "format": "table"
      }]
    },
    {
      "id": 4,
      "title": "Avg Daily Demand",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "refId": "A",
        "rawSql": "SELECT COALESCE(AVG(avg_qty), 0) FROM actuals_daily_rollup WHERE bucket >= now() - interval '30 days'",
        "format": "table"
      }],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 1}}
    },
    {
      "id": 5,
      "title": "Demand Trend (Daily)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "refId": "A",
        "rawSql": "SELECT bucket AS time, SUM(total_qty) AS demand FROM actuals_daily_rollup WHERE bucket >= now() - interval '30 days' GROUP BY bucket ORDER BY bucket",
        "format": "time_series"
      }]
    },
    {
      "id": 6,
      "title": "Top 10 Products by Revenue",
      "type": "barchart",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "refId": "A",
        "rawSql": "SELECT product_id::text, SUM(total_revenue) AS revenue FROM actuals_daily_rollup WHERE bucket >= now() - interval '30 days' GROUP BY product_id ORDER BY revenue DESC LIMIT 10",
        "format": "table"
      }]
    }
  ]
}
